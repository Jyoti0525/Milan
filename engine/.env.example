# Copy to `engine/.env` and fill in whichever you have. `.env` is in
# .gitignore and has been since before this file existed.
#
# Nothing here is required. Every graded number in this project is measured
# with no model at all — `milan measure --all` will show you that the local
# model and a hosted one reach the same mapping — so an empty file is the
# default configuration rather than a broken one.
#
# Anything already exported in your shell wins over this file, so CI can set
# these from a secret manager without a stale copy here quietly overriding it.
#
# A key that has been pasted into a chat window, an issue, or a screenshot is
# burned whether or not anyone noticed. Rotate it and put the new one here.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
